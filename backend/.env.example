# Copiar a .env y rellenar (no commitear .env)

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/optica
JWT_SECRET=cambiar_por_un_secreto_largo_aleatorio

# Orígenes permitidos para CORS (separados por coma) o vacío para reflejar el Origin en dev
CORS_ORIGIN=http://localhost:8080

# Solo true en despliegue controlado si quieres permitir registro público
ALLOW_REGISTER=false
